<apiEndpoint/00000000-0000-0000-0000-000000000104> om:hasDataProduct <dataProduct/00000000-0000-0000-0000-000000000004> ;
  rdfs:label "API 4" ;
  om:belongsToService <apiService/mock> .

<dataProduct/00000000-0000-0000-0000-000000000001> om:hasOwner <team/contact> ;
  om:hasTag <tag/health> ;
  om:hasExtension <product-extension> .

<team/contact> rdfs:label "Mock contact" ;
  foaf:mbox "mock@example.org" ;
  om:hasExtension <contact-extension> .

<contact-extension> om:hasExtensionProperty <contact-page> .
<contact-page> om:extensionKey "contactPage" ;
  om:extensionValue "https://example.org/contact" .

<tag/health> rdfs:label "Health" ;
  dct:description "[Source](http://publications.europa.eu/resource/authority/data-theme/HEAL)" ;
  om:tagFQN "dcat_theme.HEAL" .

<product-extension> om:hasExtensionProperty
  <keywords>, <structured>, <provenance>, <hdab>, <distributions> .

<keywords> om:extensionKey "healthKeywords" ;
  om:extensionValue '''["synthetic","health"]''' .
<structured> om:extensionKey "healthHasStructuredData" ;
  om:extensionValue '''["true"]''' .
<provenance> om:extensionKey "healthProvenance" ;
  om:extensionValue "Manually created test indicators" .
<hdab> om:extensionKey "healthHdab" ;
  om:extensionValue '''{"rows":[{"name":"Mock HDAB","email":"hdab@example.org","contactpage":"https://example.org/hdab"}]}''' .
<distributions> om:extensionKey "healthDistributions" ;
  om:extensionValue '''{"rows":[
    {"accessURLs":"[\\"https://example.org/data.json\\"]","applicableLegislation":"[\\"http://data.europa.eu/eli/reg/2025/327/oj\\"]"},
    {"accessURLs":"[\\"https://example.org/data.csv\\"]","applicableLegislation":"[\\"http://data.europa.eu/eli/reg/2025/327/oj\\"]"}
  ]}''' .

<apiEndpoint/00000000-0000-0000-0000-000000000105> om:hasDataProduct <dataProduct/00000000-0000-0000-0000-000000000001> ; rdfs:label "Alternative API" .
