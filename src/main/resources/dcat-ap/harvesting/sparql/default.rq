PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

CONSTRUCT {
  ?subject ?predicate ?object .
}
WHERE {
  {
    SELECT DISTINCT ?subject WHERE {
      VALUES ?type { dcat:Catalog dcat:CatalogRecord dcat:Dataset dcat:DatasetSeries dcat:DataService }
      ?resource a ?type .
      # Include descriptions of linked resources and blank nodes without following class definitions.
      ?resource (!rdf:type)* ?subject .
    }
  }
  ?subject ?predicate ?object .
}
